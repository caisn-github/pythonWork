def LC_70(n:int):
    idp = [0] * n
    if n <= 1:
        return 1
    idp[0] = 1 # 这个是为了方便进行初始化
    idp[1] = 1
    for i in range (2,n):
        idp[i] = idp[i-1] + idp[i-2]
    
    return idp


def bag01(n:int, V:int, v: List[int], w:List[int]):

    # 首先需要声明一个二维的数组
    s = [[0] * V for _ in range (n)]
    # 假设当前的这个不放，假设当前的这个要放
    for i in range (1,n+1):
        for j in range (1,V+1):
            s[i][j] = max(s[i-1][j], s[i-1][j-v[i]] + w[i])
    return s 



import sys

def my_bubble_sort(n:int, mylist:list):
    ## 这个是冒泡排序的解法
    for i in range (n):
        flag = bool(0)
        for j in range(n-i):
            ## 每一轮都交换数字，小的在左，大的在右，直到冒泡冒到最上面
            if mylist[j] > mylist[j+1]:
                tmp = mylist[j]
                mylist[j] = mylist[j]
                mylist[j] = tmp

    print(mylist)
    return


